# ---------------------------------------------------------------------------
# Jan Purna (जन पूर्णा) - Cotton Seed Oil Cake Marketplace
# Example environment file: documents the NAMES of every configuration
# variable the application reads. It contains NO real values.
#
# Secrets and credentials MUST be provided only through environment variables
# or the host secret manager and MUST NEVER be committed to version control
# (Req 12.5). Copy this file to ".env" locally (".env" is git-ignored) and fill
# in real values, or set these variables in your deployment's secret manager.
# ---------------------------------------------------------------------------

# --- Required secrets (the app fails fast on startup if any are missing) ---

# Telegram Bot API token issued by BotFather.
BOT_TOKEN=

# PostgreSQL connection string (may contain credentials; treated as a secret).
DB_URL=

# Credential/key for the object-storage bucket (payment screenshots).
OBJECT_STORE_KEY=

# Encryption key used to encrypt the Verified_Contact (phone number) at rest.
VERIFIED_CONTACT_ENCRYPTION_KEY=

# Telegram user id of the single Seller/Admin (integer). Not a secret, but
# required: the Admin role is assigned only to this id (Req 1.6).
SELLER_TELEGRAM_ID=

# --- Optional: webhook mode (Phase 2 / scale) ------------------------------

# Enable webhook mode instead of v1 long-polling (one of: 1/0, true/false,
# yes/no, on/off). Defaults to false.
USE_WEBHOOK=

# Secret token validated on the X-Telegram-Bot-Api-Secret-Token header.
# Required ONLY when USE_WEBHOOK is enabled (Req 12.3/12.4).
WEBHOOK_SECRET_TOKEN=

# --- Optional seed values (authoritative source is seller_settings in DB) --

# Initial UPI VPA to seed seller_settings (Seller can change it later).
UPI_ADDRESS=

# Initial object-storage reference for the static UPI QR image (seed only).
UPI_QR_OBJECT_KEY=

# Accepted UTR format as a regex. Optional; defaults to exactly 12 alphanumeric
# characters: ^[A-Za-z0-9]{12}$ (Req 6.2/6.6).
UTR_PATTERN=
